// Embeds the Atomik application icon into the executable. Windows uses the
// icon resource with the lowest numeric ID as the file / taskbar / shortcut
// icon, so this single entry is all that is required.
101 ICON "..\\Assets\\atomik_icon.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Atomik"
            VALUE "FileDescription",  "Atomik Simulation Engine"
            VALUE "FileVersion",      "1.3.0"
            VALUE "InternalName",     "AtomikSimulationEngine"
            VALUE "OriginalFilename", "Atomik Simulation Engine.exe"
            VALUE "ProductName",      "Atomik Simulation Engine"
            VALUE "ProductVersion",   "1.3.0"
            VALUE "LegalCopyright",   "Atomik"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
